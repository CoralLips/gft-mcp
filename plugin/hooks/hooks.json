{
  "description": "gft hooks: program-level slash commands (list/login answered directly, zero model calls)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gft-hook.js\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
